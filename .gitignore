.env
.env.*
!.env.example
.DS_Store
**/.DS_Store

# Generated media and temporary analysis assets
replication/images/
replication/videos/
replication/audio/
replication/edit/
**/*-task.json
**/*-task.json.status.json
*.mp4
*.MP4
*.mov
*.wav
*.mp3
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.webm
*.mov
*.MOV

# Backups and transient orchestrator state markers
*.bak
/generated_pending_qc
/submitting

# Raw image-gen API responses embed base64 image payloads (b64_json) — treat as media
**/audit/assets/**/response.json

# Per-generation video response JSONs carry a download URL to the generated MP4
# (a media pointer) — treat as media, keep out of the text-only repo
**/shots/**/video/*.json
# Any generation audit evidence dirs (base64/URLs) if ever placed in-tree
**/.audit/

# MPEG-TS 分段与其他媒体容器(仓库无 TypeScript 源码)
*.ts
*.m4a
*.aac
*.mkv
*.webm
