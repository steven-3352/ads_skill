      "requiredBeats": [
        { "id": "P03-b1", "sceneId": "living_room", "text": "手机又震来电显示“阿沉”，阿澈拇指在屏幕上方悬半秒又一次滑向挂断（消息/来电提示音）", "channels": ["picture", "action_sound"] },
        { "id": "P03-b2", "sceneId": "living_room", "text": "门被推开，阿沉拖着行李箱走进玄关，逆着楼道冷光站门口看她，手里还攥着刚被挂断的手机（门轴轻响，行李箱轮子滚过门槛）", "channels": ["picture", "action_sound"] },
        { "id": "P03-b3", "sceneId": "living_room", "text": "阿澈猛地抬头，前一秒的甜笑瞬间冻住，随即又堆上标准甜笑", "channels": ["picture"] },
        { "id": "P03-b4", "sceneId": "living_room", "text": "阿澈：你怎么这点来了？我正忙着回消息呢。", "channels": ["picture", "dialogue"] },
        { "id": "P03-b5", "sceneId": "living_room", "text": "阿沉：我来拿我的东西。", "channels": ["picture", "dialogue"] },
        { "id": "P03-b6", "sceneId": "living_room", "text": "阿澈：急什么，等我回完这条。你吃了没，我给你煮碗面？（消息提示音响起）", "channels": ["picture", "dialogue", "action_sound"] },
        { "id": "P03-b7", "sceneId": "living_room", "text": "阿沉：阿澈，我在门口站了十分钟。你手机响一次你抬一次头。你连我要走，都没舍得看我一眼——刚才我打给你，你把我挂了。（氛围电子渐强）", "channels": ["picture", "dialogue", "ambience"] },
        { "id": "P03-b8", "sceneId": "living_room", "text": "阿澈的笑意僵在脸上，手指悬在屏幕上方，停住", "channels": ["picture"] }
