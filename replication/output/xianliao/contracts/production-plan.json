      "requiredBeats": [
        { "id": "P02-b1", "sceneId": "living_room", "text": "14:00同事私聊请帮忙，阿澈秒回“没问题，包在我身上！”（消息提示音不断）", "channels": ["picture", "onscreen_text", "action_sound"] },
        { "id": "P02-b2", "sceneId": "living_room", "text": "15:00闲聊群聊明星，阿澈插话“我也觉得！他好帅！”（时钟走针声继续）", "channels": ["picture", "onscreen_text", "ambience"] },
        { "id": "P02-b3", "sceneId": "living_room", "text": "16:00群里表情包，她秒回表情包又补一句“哈哈哈”", "channels": ["picture", "onscreen_text"] },
        { "id": "P02-b4", "sceneId": "living_room", "text": "内心VO：我要是说不去，他们会不会觉得我不合群？（12:30同事群喊吃饭她头也不回走了，阿沉点的外卖原封不动放桌上忘拿）", "channels": ["picture", "onscreen_text", "dialogue"] },
        { "id": "P02-b5", "sceneId": "living_room", "text": "17:00妈妈连发三条“晚饭吃了吗”“降温了记得加衣服”“这周末回来吗？”，阿澈只回一条“嗯，再说吧。”", "channels": ["picture", "onscreen_text"] },
        { "id": "P02-b6", "sceneId": "living_room", "text": "19:30阿沉连发三条“今天有空吗”“我给你带了你想吃的”“在吗”，全部已读不回", "channels": ["picture", "onscreen_text"] },
        { "id": "P02-b7", "sceneId": "living_room", "text": "20:00阿沉来电，阿澈看了一眼手指滑向挂断，切回群里继续回消息", "channels": ["picture", "onscreen_text"] },
        { "id": "P02-b8", "sceneId": "living_room", "text": "01:50深夜阿澈还躺在工作群里回“收到！辛苦啦~”（时钟走针声骤然停下）", "channels": ["picture", "onscreen_text", "ambience"] }
