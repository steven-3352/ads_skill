    {
      "id": "P08",
      "title": "片段八·等来的永远是最后-排最后一个",
      "source": {
        "storyFile": "story/xiaoliao.md",
        "verbatim": "#### 片段八：01:45 - 02:00（本段包含 6 个分镜）"
      },
      "requiredBeats": [
        { "id": "P08-b1", "sceneId": "living_room", "text": "阿沉：你妈连发三条，你回一个“嗯”。我打十个电话，你挂十个。", "channels": ["picture", "dialogue"] },
        { "id": "P08-b2", "sceneId": "living_room", "text": "阿澈：（崩溃）我等了你五年，你就这么走？", "channels": ["picture", "dialogue"] },
        { "id": "P08-b3", "sceneId": "living_room", "text": "阿沉站定，伸手拉起行李箱拉杆，指节用力到发白", "channels": ["picture"] },
        { "id": "P08-b4", "sceneId": "living_room", "text": "阿沉：我心疼你，你嫌压力；我惦记你，你说麻烦。别人随口一句“辛苦啦”，你能供一晚上、当成命。", "channels": ["picture", "dialogue"] },
        { "id": "P08-b5", "sceneId": "living_room", "text": "阿沉：我等你五年，等来的，是我永远排最后一个。（弦乐一声低鸣）", "channels": ["picture", "dialogue", "ambience"] },
        { "id": "P08-b6", "sceneId": "living_room", "text": "阿澈整个人僵住，眼泪大颗砸下来", "channels": ["picture"] }
      ],
