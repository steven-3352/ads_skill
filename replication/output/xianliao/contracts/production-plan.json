        "verbatim": "#### 片段一：00:00 - 00:15（本段包含 8 张图卡 + 4 句内心对白）"
      },
      "requiredBeats": [
        { "id": "P01-b1", "sceneId": "living_room", "text": "工作群07:00领导发通知，阿澈秒回“收到，好的老板！”（手机截图俯拍大特写，急促消息提示音+低频氛围电子铺底）", "channels": ["picture", "onscreen_text", "action_sound", "ambience"] },
        { "id": "P01-b2", "sceneId": "living_room", "text": "闺蜜群09:30八卦链接，阿澈秒回“哈哈哈哈笑死我了！”（时钟走针声叠入）", "channels": ["picture", "onscreen_text", "ambience"] },
        { "id": "P01-b3", "sceneId": "living_room", "text": "朋友群10:30自拍，阿澈连发三条夸“好看！绝了！你皮肤也太好了！”", "channels": ["picture", "onscreen_text"] },
        { "id": "P01-b4", "sceneId": "living_room", "text": "内心VO：他是天蝎座，你觉得他什么意思？我该怎么回？", "channels": ["picture", "onscreen_text", "dialogue"] },
        { "id": "P01-b5", "sceneId": "living_room", "text": "内心VO：他这性格，跟你前男友很像，你觉得他到底什么意思？", "channels": ["picture", "onscreen_text", "dialogue"] },
        { "id": "P01-b6", "sceneId": "living_room", "text": "内心VO：我这么说是不是不好？他会不会不高兴？", "channels": ["picture", "onscreen_text", "dialogue"] },
        { "id": "P01-b7", "sceneId": "living_room", "text": "内心VO：他如果爱我，会懂我。（12:00阿沉点的外卖已读却未回）", "channels": ["picture", "onscreen_text", "dialogue"] },
        { "id": "P01-b8", "sceneId": "living_room", "text": "内心VO：每天要应付各种人，好累。可被需要、被认可的感觉，好满足。（切真人中景，屏幕光打在她眼下青黑的脸上，惯性甜笑眼神空）", "channels": ["picture", "dialogue"] }
      ],
