      "requiredBeats": [
        { "id": "P04-b1", "sceneId": "living_room", "text": "阿澈：你说什么呢，我们不是好好的？你是不是工作不顺心？", "channels": ["picture", "dialogue"] },
        { "id": "P04-b2", "sceneId": "living_room", "text": "阿沉：我工作挺顺。不顺心的，是我等你这五年。", "channels": ["picture", "dialogue"] },
        { "id": "P04-b3", "sceneId": "living_room", "text": "阿澈：我怎么让你不顺心了？我对你还不够好？", "channels": ["picture", "dialogue"] },
        { "id": "P04-b4", "sceneId": "living_room", "text": "阿沉：你以为你善良？你是怕。群里少回一句你怕得睡不着，你自己的价值就是去讨好吗？我一晚上没信儿，你睡得可香。", "channels": ["picture", "dialogue"] },
        { "id": "P04-b5", "sceneId": "living_room", "text": "阿澈：（急）我那是……群里有人等我回话。", "channels": ["picture", "dialogue"] },
        { "id": "P04-b6", "sceneId": "living_room", "text": "阿沉：群里没人等你。", "channels": ["picture", "dialogue"] },
