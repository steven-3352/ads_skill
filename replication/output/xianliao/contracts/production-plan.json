    {
      "id": "P09",
      "title": "片段九·等来的永远是最后-你不敢停",
      "source": {
        "storyFile": "story/xiaoliao.md",
        "verbatim": "#### 片段九：02:00 - 02:15（本段包含 6 个分镜）"
      },
      "requiredBeats": [
        { "id": "P09-b1", "sceneId": "living_room", "text": "阿沉拨开她挡着门的手，拖起行李箱转身（行李箱轮子转动）", "channels": ["picture", "action_sound"] },
        { "id": "P09-b2", "sceneId": "living_room", "text": "阿沉拖着行李箱走向门口，阿澈在身后伸手想抓又停住", "channels": ["picture"] },
        { "id": "P09-b3", "sceneId": "living_room", "text": "阿沉在门框里站定，回头看了她最后一眼，眼里平静却发红", "channels": ["picture"] },
        { "id": "P09-b4", "sceneId": "living_room", "text": "阿澈：我改……我改还不行吗？你别走。", "channels": ["picture", "dialogue"] },
        { "id": "P09-b5", "sceneId": "living_room", "text": "阿沉看着她的眼泪，平静地一字一句（弦乐沉到底）", "channels": ["picture", "ambience"] },
        { "id": "P09-b6", "sceneId": "living_room", "text": "阿沉：你改不了。你不是不会爱我——是你不敢停。你一停下来，就得面对：没人真的需要你。所以你宁可一条条回“收到”，也不敢好好看我一眼。", "channels": ["picture", "dialogue"] }
