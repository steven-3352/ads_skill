      "requiredBeats": [
        { "id": "P05-b1", "sceneId": "living_room", "text": "阿沉：你半夜给同事改方案，朋友喊一声搬家你就冲出去。", "channels": ["picture", "dialogue"] },
        { "id": "P05-b2", "sceneId": "living_room", "text": "阿沉：同事说“明天发”，你回“好的收到辛苦啦”；别人发个表情包，你也得回个表情包。", "channels": ["picture", "dialogue"] },
        { "id": "P05-b3", "sceneId": "living_room", "text": "阿沉：人家一句“我先睡了”，你都要接“晚安明天见”。这些话说给谁听都行，就是没人真的要听。", "channels": ["picture", "dialogue"] },
        { "id": "P05-b4", "sceneId": "living_room", "text": "阿澈别过脸，下颔线绷紧，手无意识攥紧衣角", "channels": ["picture"] },
        { "id": "P05-b5", "sceneId": "living_room", "text": "阿沉：可你不接，你就心慌。你退那些群，三天，没一个人问你去哪了——你自己心里清楚。（氛围电子压到最低）", "channels": ["picture", "dialogue", "ambience"] },
        { "id": "P05-b6", "sceneId": "living_room", "text": "阿沉：连一句没人要的“收到”，都排在我前面。", "channels": ["picture", "dialogue"] },
        { "id": "P05-b7", "sceneId": "living_room", "text": "阿澈瞳孔骤缩，呼吸发紧，眼眶泛红，眼泪硬压着不掉", "channels": ["picture"] }
